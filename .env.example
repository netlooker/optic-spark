# =========================================================
# Optic-Spark Environment Configuration
# =========================================================

# Optional: Host directory containing the Z-Image-Turbo Q4_K_M GGUF model.
# If provided, Docker will mount this directory directly, bypassing the 
# download process and utilizing your DGX Spark's existing cache.
# Example: HOST_MODEL_DIR=/mnt/hf_cache/unsloth/Z-Image-Turbo-GGUF
# HOST_MODEL_DIR=

# Optional: Exact path to the GGUF file inside the container.
# If left blank, the engine will auto-discover any *Q4_K_M.gguf* in the mounted /model directory.
# GGUF_MODEL_PATH=/model/Z-Image-Turbo-Q4_K_M.gguf

# Optional: Set the host port the API will listen on (default is 7070)
# API_PORT=7070

# Required in production: the publicly reachable URL of this DGX host.
# This is used to construct the image download URL in webhook callbacks.
# Example: BASE_URL=http://192.168.1.100:7070
# BASE_URL=http://localhost:7070
